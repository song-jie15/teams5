{
	"scripts": {
		"web": "pnpm --filter @en/web dev",
		"server": "pnpm --filter @en/server start:dev",
		"ai": "pnpm --filter @en/server start:dev ai",
		"all": "concurrently \"pnpm run web\" \"pnpm run server\" \"pnpm run ai\""
	},
	"dependencies": {
		"@types/md5": "^2.3.6",
		"concurrently": "^9.2.1",
		"dayjs": "^1.11.19",
		"md5": "^2.3.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@nestjs/core", "@prisma/engines", "esbuild", "prisma", "unrs-resolver", "vue-demi"]
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^25.6.0",
		"@types/passport-jwt": "^4.0.1"
	}
}
